# =============================================================
# Heapify Frontend — Environment Variables
# Copy this file to .env.local for local development.
# Set these in Vercel Dashboard → Project → Settings → Environment Variables
# =============================================================

# ── Backend API ────────────────────────────────────────────────
# Auth-specific base URL (used by /auth/refresh etc.)
NEXT_PUBLIC_API_URL=https://your-backend.vercel.app/api/auth

# General API base URL (used for all other API calls)
NEXT_PUBLIC_API_BASE_URL=https://your-backend.vercel.app/api

# ── Feature Flags ──────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_BETA_FEATURES=false

# ── Optional Third-party Services ─────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
